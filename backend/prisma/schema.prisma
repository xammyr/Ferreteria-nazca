generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categorias {
  id          Int         @id @default(autoincrement())
  nombre      String      @db.VarChar(100)
  descripcion String?     @db.Text
  icono       String?     @db.VarChar(10)
  activa      Boolean?    @default(true)
  productos   productos[]
}

model proveedores {
  id          Int         @id @default(autoincrement())
  nombre      String      @db.VarChar(150)
  contacto    String?     @db.VarChar(100)
  telefono    String?     @db.VarChar(50)
  email       String?     @db.VarChar(150)
  direccion   String?     @db.VarChar(255)
  activo      Boolean?    @default(true)
  creado_en   DateTime?   @default(now()) @db.Timestamp(6)
  productos   productos[]
}

model productos {
  id                     Int                      @id @default(autoincrement())
  codigo                 String                   @unique @db.VarChar(50)
  nombre                 String                   @db.VarChar(150)
  descripcion            String?                  @db.Text
  categoria_id           Int?
  proveedor_id           Int?
  precio_compra          Decimal                  @default(0) @db.Decimal(10, 2)
  precio_venta           Decimal                  @db.Decimal(10, 2)
  unidad                 String?                  @default("unidad") @db.VarChar(50)
  stock_actual           Int?                     @default(0)
  stock_minimo           Int?                     @default(5)
  imagen_url             String?                  @db.VarChar(255)
  visible_web            Boolean?                 @default(true)
  visible_chatbot        Boolean?                 @default(true)
  activo                 Boolean?                 @default(true)
  creado_en              DateTime?                @default(now()) @db.Timestamp(6)
  actualizado_en         DateTime?                @default(now()) @updatedAt @db.Timestamp(6)
  categorias             categorias?              @relation(fields: [categoria_id], references: [id], onDelete: SetNull)
  proveedores            proveedores?             @relation(fields: [proveedor_id], references: [id], onDelete: SetNull)
  inventario_movimientos inventario_movimientos[]
  venta_items            venta_items[]
  carrito_items          carrito_items[]
  producto_imagenes      producto_imagenes[]

  @@index([categoria_id])
  @@index([proveedor_id])
}

model producto_imagenes {
  id          Int       @id @default(autoincrement())
  producto_id Int
  url         String    @db.VarChar(255)
  orden       Int?      @default(0)
  creado_en   DateTime? @default(now()) @db.Timestamp(6)
  productos   productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)
}

model clientes {
  id               String             @id @default(uuid()) @db.Uuid
  nombre           String             @db.VarChar(100)
  telefono         String?            @db.VarChar(50)
  email            String?            @unique @db.VarChar(150)
  direccion        String?            @db.Text
  canal_origen     String?            @default("web") @db.VarChar(50)
  creado_en        DateTime?          @default(now()) @db.Timestamp(6)
  password         String?            @db.VarChar(255)
  ventas           ventas[]
  carritos         carritos[]
  chatbot_sesiones chatbot_sesiones[]
}

model usuarios {
  id                     String                   @id @default(uuid()) @db.Uuid
  nombre                 String                   @db.VarChar(100)
  email                  String                   @unique @db.VarChar(150)
  password               String                   @db.VarChar(255)
  rol                    String?                  @default("vendedor") @db.VarChar(50)
  activo                 Boolean?                 @default(true)
  creado_en              DateTime?                @default(now()) @db.Timestamp(6)
  ventas                 ventas[]
  inventario_movimientos inventario_movimientos[]
}

model inventario_movimientos {
  id             Int       @id @default(autoincrement())
  producto_id    Int
  tipo           String    @db.VarChar(50)
  cantidad       Int
  stock_anterior Int
  stock_nuevo    Int
  referencia     String?   @db.VarChar(255)
  usuario_id     String?   @db.Uuid
  notas          String?   @db.Text
  creado_en      DateTime? @default(now()) @db.Timestamp(6)
  productos      productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  usuarios       usuarios? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([producto_id])
  @@index([usuario_id])
}

model ventas {
  id              String        @id @default(uuid()) @db.Uuid
  numero          Int           @default(autoincrement()) @unique
  cliente_id      String?       @db.Uuid
  usuario_id      String?       @db.Uuid
  canal           String?       @default("presencial") @db.VarChar(50)
  estado          String?       @default("pendiente") @db.VarChar(50)
  subtotal        Decimal       @db.Decimal(10, 2)
  descuento       Decimal?      @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  metodo_pago     String?       @db.VarChar(50)
  comprobante_url String?       @db.VarChar(255)
  notas           String?       @db.Text
  creado_en       DateTime?     @default(now()) @db.Timestamp(6)
  actualizado_en  DateTime?     @default(now()) @updatedAt @db.Timestamp(6)
  clientes        clientes?     @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  usuarios        usuarios?     @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  venta_items     venta_items[]

  @@index([cliente_id])
  @@index([usuario_id])
}

model venta_items {
  id              Int       @id @default(autoincrement())
  venta_id        String    @db.Uuid
  producto_id     Int
  nombre_producto String    @db.VarChar(150)
  precio_unitario Decimal   @db.Decimal(10, 2)
  cantidad        Int
  subtotal        Decimal   @db.Decimal(10, 2)
  ventas          ventas    @relation(fields: [venta_id], references: [id], onDelete: Cascade)
  productos       productos @relation(fields: [producto_id], references: [id])

  @@index([venta_id])
  @@index([producto_id])
}

model carritos {
  id             String          @id @default(uuid()) @db.Uuid
  cliente_id     String?         @db.Uuid
  sesion_key     String?         @db.VarChar(255)
  creado_en      DateTime?       @default(now()) @db.Timestamp(6)
  actualizado_en DateTime?       @default(now()) @updatedAt @db.Timestamp(6)
  clientes       clientes?       @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  carrito_items  carrito_items[]

  @@index([cliente_id])
}

model carrito_items {
  id          Int       @id @default(autoincrement())
  carrito_id  String    @db.Uuid
  producto_id Int
  cantidad    Int       @default(1)
  agregado_en DateTime? @default(now()) @db.Timestamp(6)
  carritos    carritos  @relation(fields: [carrito_id], references: [id], onDelete: Cascade)
  productos   productos @relation(fields: [producto_id], references: [id])

  @@index([carrito_id])
  @@index([producto_id])
}

model chatbot_sesiones {
  id               String             @id @default(uuid()) @db.Uuid
  cliente_id       String?            @db.Uuid
  telefono         String?            @db.VarChar(50)
  estado           String?            @default("activa") @db.VarChar(50)
  paso_actual      String?            @db.VarChar(50)
  creado_en        DateTime?          @default(now()) @db.Timestamp(6)
  actualizado_en   DateTime?          @default(now()) @updatedAt @db.Timestamp(6)
  clientes         clientes?          @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  chatbot_mensajes chatbot_mensajes[]

  @@index([cliente_id])
}

model chatbot_mensajes {
  id               Int              @id @default(autoincrement())
  sesion_id        String           @db.Uuid
  origen           String           @db.VarChar(50)
  contenido        String           @db.Text
  tipo             String?          @default("texto") @db.VarChar(50)
  media_url        String?          @db.VarChar(255)
  creado_en        DateTime?        @default(now()) @db.Timestamp(6)
  chatbot_sesiones chatbot_sesiones @relation(fields: [sesion_id], references: [id], onDelete: Cascade)

  @@index([sesion_id])
}

model configuracion {
  clave       String  @id @db.VarChar(100)
  valor       String? @db.Text
  descripcion String? @db.VarChar(255)
}
